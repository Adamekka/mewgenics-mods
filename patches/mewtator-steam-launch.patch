diff --git a/app/steam_launch.py b/app/steam_launch.py
new file mode 100644
index 0000000..47ac9b0
--- /dev/null
+++ b/app/steam_launch.py
@@ -0,0 +1,78 @@
+import json
+import os
+from pathlib import Path
+import shlex
+import sys
+
+from app.core.models.config import Config
+from app.core.services.dll_injection_service import DllInjectionService
+from app.core.services.game_launcher_service import GameLauncherService
+from app.core.services.mod_service import ModService
+from app.infrastructure.mod_repository import ModRepository
+from app.utils.logging_utils import get_logger
+from app.utils.platform_utils import get_executable_dir
+
+
+class SteamLaunchError(Exception):
+    """A launch problem that the user can resolve in Mewtator or Steam."""
+
+
+def launch_from_steam(command: list[str]) -> None:
+    if not command:
+        raise SteamLaunchError("Set Steam's launch options to include %command% after --steam.")
+    config_path = Path(get_executable_dir()) / "config.json"
+    try:
+        config = Config.from_dict(json.loads(config_path.read_text(encoding="utf-8")))
+        config.normalize_paths()
+    except (OSError, ValueError, TypeError) as error:
+        raise SteamLaunchError("Open Mewtator and save your game and mod settings, then try again.") from error
+    if not config.is_valid() or not (Path(config.mod_folder) / "modlist.txt").is_file():
+        raise SteamLaunchError("Open Mewtator and check your game and mods folders, then try again.")
+
+    mod_service = ModService(ModRepository(config.mod_folder))
+    mod_list = mod_service.load_mods()
+    missing = mod_service.get_missing_mod_names(mod_list)
+    if missing:
+        raise SteamLaunchError("Restore or disable these missing mods in Mewtator: " + ", ".join(missing))
+    requirements = mod_service.validate_requirements(mod_list)
+    if requirements:
+        raise SteamLaunchError("Fix these mod requirements in Mewtator before playing:\n\n" + "\n".join(requirements))
+
+    dll_service = DllInjectionService()
+    if dll_service.has_dll_mods(mod_list) and not config.dll_injection_enabled:
+        raise SteamLaunchError("Enable DLL mod support in Mewtator before using your enabled DLL mods.")
+    launcher = GameLauncherService(dll_service)
+    if not Path(launcher.find_executable(config.game_install_dir)).is_file():
+        raise SteamLaunchError("Finish installing Mewgenics in Steam, then try again.")
+    if not launcher.prepare_dll_manifest(config.game_install_dir, config, mod_list):
+        raise SteamLaunchError("Check Mewjector and your mods folder permissions in Mewtator, then try again.")
+    paths = mod_service.get_launch_mod_paths(mod_list, config)
+    options = shlex.split(launcher.get_launch_options(config.game_install_dir, paths, config, mod_list))
+    env = os.environ.copy()
+    if "%command%" in options:
+        if options.count("%command%") != 1:
+            raise SteamLaunchError("Remove %command% from Mewtator's custom launch options. Keep it only in Steam's launch options.")
+        position = options.index("%command%")
+        for assignment in options[:position]:
+            name, separator, value = assignment.partition("=")
+            assert separator and name in {"STEAM_COMPAT_MOUNTS", "WINEDLLOVERRIDES"}, "Unexpected launch environment assignment"
+            # Preserve Steam's existing mounts and DLL overrides alongside Mewtator's requirements.
+            if env.get(name):
+                value = env[name] + (":" if name == "STEAM_COMPAT_MOUNTS" else ";") + value
+            env[name] = value
+        game_args = options[position + 1:]
+    else:
+        game_args = options
+
+    # Frozen apps prepend bundled libraries; Proton must retain Steam's original library search path.
+    if getattr(sys, "frozen", False):
+        if "LD_LIBRARY_PATH_ORIG" in env:
+            env["LD_LIBRARY_PATH"] = env["LD_LIBRARY_PATH_ORIG"]
+        else:
+            env.pop("LD_LIBRARY_PATH", None)
+    get_logger().info("Steam launch with %d enabled mods: %s", len(mod_list.enabled_mods), shlex.join(command + game_args))
+    try:
+        # Replacing this process keeps Steam's game tracking and original Proton command intact.
+        os.execvpe(command[0], command + game_args, env)
+    except OSError as error:
+        raise SteamLaunchError("Steam's game command could not start. Restart Steam and try again.") from error
