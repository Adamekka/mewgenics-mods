new file mode 100644
index 0000000..3b5b1ca
--- /dev/null
+++ b/tests/test_steam_launch.py
@@ -0,0 +1,113 @@
+import json
+import os
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+from app.core.models.config import Config
+from app.steam_launch import SteamLaunchError, launch_from_steam
+
+
+class SteamLaunchTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.game = self.root / "Mewgenics"
+        self.game.mkdir()
+        (self.game / "Mewgenics.exe").touch()
+        self.mods = self.root / "mods"
+        self.mods.mkdir()
+        (self.mods / "modlist.txt").write_text("")
+        self.config = Config(game_install_dir=str(self.game), mod_folder=str(self.mods), mewtator_intro_enabled=False)
+        self.command = ["/usr/bin/proton test", "run", "/game path/Mewgenics.exe", "original arg"]
+        self.addCleanup(patch.stopall)
+        patch("app.steam_launch.get_executable_dir", return_value=str(self.root)).start()
+        patch("app.steam_launch.get_logger").start()
+        self.execute = patch("app.steam_launch.os.execvpe").start()
+
+    def save_config(self):
+        (self.root / "config.json").write_text(json.dumps(self.config.to_dict()))
+
+    def test_preserves_original_command_and_saved_mod_order(self):
+        for name in ["First", "Second mod", "Disabled"]:
+            (self.mods / name).mkdir()
+        (self.mods / "modlist.txt").write_text("Second mod\nFirst\n")
+        self.config.custom_launch_options = '--label "value with spaces"'
+        self.save_config()
+        launch_from_steam(self.command)
+        executable, args, env = self.execute.call_args.args
+        self.assertEqual(executable, self.command[0])
+        self.assertEqual(args[:len(self.command)], self.command)
+        self.assertEqual(args[len(self.command):len(self.command) + 3], ["--label", "value with spaces", "-modpaths"])
+        self.assertTrue(args[-2].endswith("\\Second mod"))
+        self.assertTrue(args[-1].endswith("\\First"))
+        self.assertEqual(len(args), len(self.command) + 5)
+        self.assertIn(str(self.mods), env["STEAM_COMPAT_MOUNTS"])
+
+    def test_reloads_saved_selection_on_every_launch(self):
+        (self.mods / "Enabled").mkdir()
+        (self.mods / "modlist.txt").write_text("Enabled\n")
+        self.save_config()
+        launch_from_steam(self.command)
+        self.assertIn("-modpaths", self.execute.call_args.args[1])
+        (self.mods / "modlist.txt").write_text("")
+        launch_from_steam(self.command)
+        self.assertEqual(self.execute.call_args.args[1], self.command)
+
+    def test_placeholder_in_custom_options_has_actionable_error(self):
+        self.config.custom_launch_options = "%command%"
+        self.save_config()
+        with self.assertRaisesRegex(SteamLaunchError, "Remove %command%"):
+            launch_from_steam(self.command)
+        self.execute.assert_not_called()
+
+    def test_missing_mod_aborts_instead_of_launching_without_it(self):
+        (self.mods / "modlist.txt").write_text("Missing\n")
+        self.save_config()
+        with self.assertRaisesRegex(SteamLaunchError, "Missing"):
+            launch_from_steam(self.command)
+        self.execute.assert_not_called()
+
+    def test_invalid_dependency_aborts(self):
+        mod = self.mods / "Dependent"
+        mod.mkdir()
+        (mod / "description.json").write_text(json.dumps({"requirements": ["Required"]}))
+        (self.mods / "modlist.txt").write_text("Dependent\n")
+        self.save_config()
+        with self.assertRaisesRegex(SteamLaunchError, "Required"):
+            launch_from_steam(self.command)
+        self.execute.assert_not_called()
+
+    def test_frozen_launch_restores_steam_libraries_and_preserves_environment(self):
+        self.config.dll_injection_enabled = True
+        self.save_config()
+        with patch("app.steam_launch.sys.frozen", True, create=True), patch.dict(os.environ, {
+            "LD_LIBRARY_PATH": "/bundled/libs:/steam/libs",
+            "LD_LIBRARY_PATH_ORIG": "/steam/libs",
+            "STEAM_COMPAT_MOUNTS": "/existing/mount",
+            "WINEDLLOVERRIDES": "dinput8=n,b",
+        }, clear=True):
+            launch_from_steam(self.command)
+        env = self.execute.call_args.args[2]
+        self.assertEqual(env["LD_LIBRARY_PATH"], "/steam/libs")
+        self.assertTrue(env["STEAM_COMPAT_MOUNTS"].startswith("/existing/mount:"))
+        self.assertEqual(env["WINEDLLOVERRIDES"], "dinput8=n,b;version=n,b")
+
+    def test_dll_manifest_is_refreshed_for_saved_selection(self):
+        mod = self.mods / "DLL mod"
+        mod.mkdir()
+        (mod / "mod.dll").touch()
+        (self.mods / "modlist.txt").write_text("DLL mod\n")
+        (self.game / "chainloader.ini").write_text("[Chainloader]\nMewtatorManifest=\n")
+        self.config.dll_injection_enabled = True
+        self.save_config()
+        launch_from_steam(self.command)
+        manifest = (self.mods / "mewtator_dll_manifest.txt").read_text()
+        self.assertTrue(manifest.strip().endswith("\\DLL mod\\mod.dll"))
+        self.assertIn("mewtator_dll_manifest.txt", (self.game / "chainloader.ini").read_text())
+
+
+if __name__ == "__main__":
+    unittest.main()
